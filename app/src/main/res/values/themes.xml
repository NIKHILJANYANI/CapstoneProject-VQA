<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- High-contrast theme for Visual Assistant — AppCompat base keeps AndroidX happy -->
    <style name="Theme.VisualAssistant" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#FFD700</item>
        <item name="android:colorAccent">#00FF00</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <!-- Large text size for accessibility -->
        <item name="android:textSize">18sp</item>
        <!-- Full screen — no status bar for maximum camera area -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
